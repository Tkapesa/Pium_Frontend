                    </pattern>
                    <image id="image0_283_452" width="512" height="512" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
                    </defs>
                  </svg>

                  Key Concepts
                </button>
                <button class="concept-btn half-width flashcards">
               
                  <svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                  <rect width="21" height="21" fill="url(#pattern0_283_362)"/>
                  <defs>
                  <pattern id="pattern0_283_362" patternContentUnits="objectBoundingBox" width="1" height="1">
                  <use xlink:href="#image0_283_362" transform="scale(0.00195312)"/>
                  </pattern>
                  <image id="image0_283_362" width="512" height="512" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
                  </defs>
                  </svg>

                  Flashcards
                </button>
              </div>

                            <!-- Quick Revision - Full Width -->
              <button class="concept-btn full-width quick-revision">
        
                Terminology
              </button>
            </div>
          </div>
        </div>

        <!-- Divider Section -->
        <!-- <div class="divider-container">
          <div class="divider-line"></div>
        </div> -->
        <div class="right-bottom-wrapper">
          <div class="lecture-quiz-wrapper">
            <span style="color: black;">Lecture quiz</span>
            <span>2/5/2025</span>
          </div>
          <div class="score-wrapper">
            <span>You scored</span>
            <strong>7/30</strong>
            <p>Review quiz</p>
            <button>New Quiz</button>
          </div>
        </div>


      </aside>
    </div>

    <!-- For Header Tooltip   -->

    <script>
      // Toggle sidebar functionality with navigation icon only
      const sidebar = document.getElementById('sidebar');
      const navigationIcon = document.querySelector('.icon-navigation');
      
      if (navigationIcon && sidebar) {
        navigationIcon.addEventListener('click', function() {
          console.log('Navigation icon clicked'); // Debug log
          sidebar.classList.toggle('collapsed');
          navigationIcon.classList.toggle('collapsed');
        });
        console.log('Navigation icon found and event listener added');
      } else {
        console.error('Navigation icon or sidebar not found!', {
          navigationIcon: !!navigationIcon,
          sidebar: !!sidebar
        });
      }

      // PDF Upload functionality
      const uploadButton = document.getElementById('uploadButton');
      const pdfFileInput = document.getElementById('pdfFileInput');
      const uploadedFilesContainer = document.getElementById('uploadedFilesContainer');
      
      // Track uploaded file names
      const uploadedFiles = new Set();
      
      // Add existing files to the set
      document.querySelectorAll('.uploaded-file span').forEach(span => {
        uploadedFiles.add(span.textContent);
      });

      uploadButton.addEventListener('click', function() {
        pdfFileInput.click();
      });

      pdfFileInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        
        if (file && file.type === 'application/pdf') {
          // Check if file already exists
          if (uploadedFiles.has(file.name)) {
            alert('This file has already been uploaded: ' + file.name);
            pdfFileInput.value = '';
            return;
          }
          
          // Get available folders
          const savedFolders = JSON.parse(localStorage.getItem('userFolders') || '[]');
          
          let folderSelection = 'Choose upload option:\n\n';
          folderSelection += '0. Upload as standalone file (no folder)\n';
          savedFolders.forEach((folder, index) => {
            folderSelection += `${index + 1}. ${folder}\n`;
          });
          folderSelection += '\nEnter the number of your choice:';
          
          const userChoice = prompt(folderSelection);
          const choiceIndex = parseInt(userChoice);
          
          if (choiceIndex === 0) {
            // Upload as standalone file
            addStandaloneFile(file.name);
            
            // Add to uploaded files set
            uploadedFiles.add(file.name);
            
            alert(`File "${file.name}" has been uploaded as a standalone file.`);
          } else if (choiceIndex >= 1 && choiceIndex <= savedFolders.length) {
            const selectedFolder = savedFolders[choiceIndex - 1];
            
            // Add file to the selected folder
            addFileToFolder(file.name, selectedFolder);
            
            // Add to uploaded files set
            uploadedFiles.add(file.name);
            
            alert(`File "${file.name}" has been added to "${selectedFolder}" folder.`);
          } else {
            alert('Invalid selection. File not uploaded.');
          }
          
          // Reset file input
          pdfFileInput.value = '';
        } else {
          alert('Please select a PDF file only.');
        }
      });
      
      // Icon box click functionality to update right side content
      const iconBoxes = document.querySelectorAll('.icon-box');
      const rightIconsSection = document.querySelector('.right-icons span');
      const rightContentList = document.querySelector('.right-content ul');
      
      // Content data for each menu item
      const menuContent = {};
      
      iconBoxes.forEach(box => {
        box.addEventListener('click', function() {
          // Remove active class from all icon-boxes
          iconBoxes.forEach(b => {
            const svg = b.querySelector('.icon svg');
            const text = b.querySelector('.icon-text span');
            if (svg) svg.classList.remove('active');
            if (text) text.classList.remove('active');
          });
          
          // Add active class to clicked icon-box
          const clickedSvg = this.querySelector('.icon svg');
          const clickedText = this.querySelector('.icon-text span');
          if (clickedSvg) clickedSvg.classList.add('active');
          if (clickedText) clickedText.classList.add('active');
          
          // Get the menu name from icon-text span
          const menuName = this.querySelector('.icon-text span').textContent;
          
          // Update right side content if menu exists in menuContent
          if (menuContent[menuName]) {
            // Update title
            rightIconsSection.textContent = menuContent[menuName].title;
            
            // Clear existing list
            rightContentList.innerHTML = '';
            
            // Add new items
            menuContent[menuName].items.forEach((item, index) => {
              const li = document.createElement('li');
              const a = document.createElement('a');
              a.href = '#';
              a.textContent = item;
              
              // Make first item active
              if (index === 0) {
                a.classList.add('active');
              }
              
              li.appendChild(a);
              rightContentList.appendChild(li);
            });
          }
        });
      });
      
      // Highlight functionality
      let highlightMode = false;
      let selectedColor = '#FFEB3B'; // Default yellow color
      const highlightBtn = document.getElementById('highlightBtn');
      const colorPickerPopup = document.getElementById('colorPickerPopup');
      const colorOptions = document.querySelectorAll('.color-option');
      const contentSection = document.querySelector('.content-section');
      
      if (highlightBtn) {
        highlightBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          // Toggle color picker popup
          colorPickerPopup.classList.toggle('show');
        });
      }
      
      // Handle color selection
      colorOptions.forEach(option => {
        option.addEventListener('click', function(e) {
          e.stopPropagation();
          selectedColor = this.getAttribute('data-color');
          highlightMode = true;
          highlightBtn.classList.add('active');
          contentSection.style.cursor = 'text';
          colorPickerPopup.classList.remove('show');
        });
      });
      
      // Close popup when clicking outside
      document.addEventListener('click', function(e) {
        if (colorPickerPopup && !colorPickerPopup.contains(e.target) && e.target !== highlightBtn) {
          colorPickerPopup.classList.remove('show');
        }
      });
      
      // Apply highlight on text selection
      if (contentSection) {
        document.addEventListener('mouseup', function() {
          if (highlightMode) {
            const selection = window.getSelection();
            
            if (selection.toString().length > 0) {
              const range = selection.getRangeAt(0);
              
              // Check if the selected text is already highlighted
              let parentElement = range.commonAncestorContainer;
              if (parentElement.nodeType === 3) { // Text node
                parentElement = parentElement.parentElement;
              }
              
              // If parent has any highlight background, remove highlight
              if (parentElement.style.backgroundColor) {
                const textContent = parentElement.textContent;
                const textNode = document.createTextNode(textContent);
                parentElement.parentNode.replaceChild(textNode, parentElement);
                selection.removeAllRanges();
                return;
              }
              
              // Otherwise, add highlight with selected color
              const span = document.createElement('span');
              span.style.backgroundColor = selectedColor; // Use selected color
              span.style.fontStyle = 'inherit'; // Keep original font style
              span.style.fontWeight = 'inherit'; // Keep original font weight
              span.style.fontFamily = 'inherit'; // Keep original font family
              span.style.fontSize = 'inherit'; // Keep original font size
              
              try {
                range.surroundContents(span);
                selection.removeAllRanges();
              } catch (e) {
                // If error occurs, use a different method
                const selectedText = selection.toString();
                const highlightedText = '<span style="background-color: ' + selectedColor + '; font-style: inherit; font-weight: inherit; font-family: inherit; font-size: inherit;">' + selectedText + '</span>';
                
                if (range.startContainer === range.endContainer && range.startContainer.nodeType === 3) {
                  const textNode = range.startContainer;
                  const before = textNode.textContent.substring(0, range.startOffset);
                  const after = textNode.textContent.substring(range.endOffset);
                  
                  const wrapper = document.createElement('span');
                  wrapper.innerHTML = before + highlightedText + after;
                  textNode.parentNode.replaceChild(wrapper, textNode);
                }
              }
            }
          }
        });
      }
      
      // Concept button click functionality
      const conceptButtons = document.querySelectorAll('.concept-btn');
      
      conceptButtons.forEach(button => {
        button.addEventListener('click', function() {
          // Remove active class from all buttons
          conceptButtons.forEach(btn => btn.classList.remove('active'));
          
          // Add active class to clicked button
          this.classList.add('active');
        });
      });
      
      // Fetch and populate Key Concepts data from API
      async function loadKeyConcepts() {
        try {
          // Keep existing content, don't clear it
          const contentSection = document.querySelector('.content-section');
          if (contentSection && !contentSection.innerHTML.trim()) {
            contentSection.innerHTML = '<div class="page"></div>';
          }
          
        } catch (error) {
          console.error('Error loading key concepts:', error);
        }
      }
      
      // Load Key Concepts on page load
      loadKeyConcepts();
      
      // Folder management functionality
      let isCreatingFolder = false;
      
      // Load saved folders from localStorage on page load
      function loadSavedFolders() {
        const savedFolders = JSON.parse(localStorage.getItem('userFolders') || '[]');
        const standaloneFiles = JSON.parse(localStorage.getItem('standaloneFiles') || '[]');
        const rightContainer = document.querySelector('.right');
        
        // Create uploadedFilesContainer if it doesn't exist
        let uploadedFilesContainer = document.getElementById('uploadedFilesContainer');
        if (!uploadedFilesContainer) {
          uploadedFilesContainer = document.createElement('div');
          uploadedFilesContainer.id = 'uploadedFilesContainer';
          uploadedFilesContainer.style.display = 'none';
          rightContainer.appendChild(uploadedFilesContainer);
        }
        
        // Create a single wrapper for all folders if it doesn't exist
        let foldersWrapper = document.getElementById('folders-wrapper');
        if (!foldersWrapper) {
          foldersWrapper = document.createElement('div');
          foldersWrapper.id = 'folders-wrapper';
          foldersWrapper.className = 'folders-container';
          rightContainer.insertBefore(foldersWrapper, uploadedFilesContainer);
        }
        
        // Load folders first
        savedFolders.forEach(folderName => {
          createFolderElement(folderName, foldersWrapper, null);
        });
        
        // Load standalone files (but don't save to localStorage again)
        standaloneFiles.forEach(fileName => {
          loadStandaloneFile(fileName);
        });
      }
      
      // Create folder element with expandable file list  
      function createFolderElement(folderName, container, insertBefore) {
        console.log('Creating folder element for:', folderName);
        const folderWrapper = document.createElement('div');
        folderWrapper.className = 'folder-wrapper';
        folderWrapper.style.marginBottom = '0px';
        folderWrapper.dataset.folderName = folderName;
        folderWrapper.setAttribute('data-folder-name', folderName);
        console.log('Folder wrapper created with data-folder-name:', folderName);
        
        // Create folder header
        const folderHeader = document.createElement('div');
        folderHeader.className = 'right-icons folder-header';
        folderHeader.style.marginBottom = '0';
        
        folderHeader.innerHTML = `
          <svg class="folder-icon-open" width="20" height="14" viewBox="0 0 25 17" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M11.0216 17C7.83067 17 4.63971 16.9995 1.44925 17C0.636891 17 0.0414929 16.4172 0.0034994 15.5775C0.000999829 15.5176 0.00149974 15.4571 0.00149974 15.3967C0.00199966 10.7986 0.00299949 6.20049 0 1.60239C0 1.08311 0.137477 0.636162 0.540908 0.301342C0.798864 0.0874285 1.09331 0.00217325 1.42326 0.00268995C3.95583 0.00630683 6.48889 0.00475674 9.02146 0.00424004C9.3629 0.00424004 9.70485 0.00372334 10.0463 0.000106454C10.9166 -0.00919412 11.514 0.591726 11.5225 1.48975C11.5255 1.79098 11.538 2.09325 11.5185 2.39345C11.502 2.65077 11.602 2.71122 11.8355 2.71019C14.1351 2.70296 16.4342 2.70554 18.7338 2.70554C19.3422 2.70554 19.9501 2.70296 20.5585 2.70657C21.4358 2.71174 22.0162 3.29096 22.0537 4.19518C22.0597 4.34141 22.0662 4.48867 22.0537 4.63386C22.0337 4.86585 22.1337 4.93251 22.3467 4.92579C22.7461 4.91287 23.1466 4.92114 23.5465 4.92217C24.6078 4.92579 25.2442 5.83156 24.9113 6.87581C24.2834 8.84598 23.6495 10.8141 23.0181 12.7827C22.6881 13.812 22.3567 14.8412 22.0282 15.871C21.9218 16.2053 21.7643 16.5035 21.4853 16.7179C21.2139 16.9271 20.9069 16.9974 20.57 16.9969C17.3875 16.9923 14.2051 16.9938 11.0221 16.9938V16.999L11.0216 17ZM11.1981 15.9821C14.2966 15.9821 17.395 15.9821 20.494 15.9821C20.8904 15.9821 20.9544 15.9444 21.0774 15.5636C22.0397 12.5755 22.9991 9.58641 23.9554 6.59679C24.1014 6.14107 23.9344 5.93594 23.435 5.93594C17.388 5.93594 11.3406 5.93594 5.2936 5.93594C4.84517 5.93594 4.76519 5.99639 4.62621 6.43042C3.82985 8.91315 3.03298 11.3959 2.23662 13.8791C2.03765 14.4997 1.84119 15.1218 1.63672 15.7403C1.57773 15.918 1.60823 16.0033 1.80319 15.9837C1.85268 15.9785 1.90318 15.9831 1.95317 15.9831C5.03514 15.9831 8.11712 15.9831 11.1991 15.9831L11.1981 15.9821ZM1.01133 14.3183C1.10981 14.2238 1.11481 14.1246 1.14281 14.0383C1.99916 11.3768 2.84901 8.71267 3.71037 6.05271C3.97982 5.22134 4.41125 4.92269 5.2616 4.92269C10.3422 4.92269 15.4234 4.92373 20.504 4.92166C21.1214 4.92166 21.0464 5.0095 21.0499 4.36156C21.0529 3.83556 20.9629 3.74514 20.455 3.74514C17.5815 3.74514 14.708 3.74514 11.8345 3.7441C11.685 3.7441 11.534 3.73945 11.3861 3.71982C10.8671 3.65058 10.5472 3.27804 10.5432 2.74377C10.5402 2.33042 10.5477 1.91706 10.5392 1.50422C10.5327 1.1849 10.3762 1.02059 10.0778 1.02007C7.20427 1.018 4.33076 1.018 1.45725 1.02007C1.1508 1.02007 1.00183 1.17663 0.986332 1.49646C0.977833 1.67679 0.981833 1.85764 0.981833 2.03796C0.981833 5.96332 0.981333 9.8892 0.982832 13.8146C0.982832 13.9737 1.00033 14.1328 1.01183 14.3183H1.01133Z" fill="black" fill-opacity="0.5"></path>
          </svg>
          <svg class="folder-icon-closed" width="22" height="16" viewBox="0 0 22 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: none;">
            <path d="M10.998 15.9975C7.79546 15.9975 4.59438 15.995 1.39184 16C0.801362 16 0.333052 15.8421 0.0799907 15.3547C0.0101806 15.2191 0 15.0749 0 14.9282C0 10.3077 0 5.68853 0.00145438 1.06808C0.00145438 0.427728 0.493034 0.00373018 1.23767 0.00248679C2.87821 0 4.5202 0.00373018 6.16074 0C6.46616 0 6.72504 0.082064 6.95919 0.246192C7.4755 0.61175 7.99907 0.968604 8.51247 1.33789C8.66663 1.44855 8.82516 1.49332 9.02732 1.49207C12.9003 1.4871 16.7719 1.48834 20.6449 1.48834C21.5364 1.48834 21.9989 1.87628 21.9989 2.636C22.0004 6.69941 22.0004 10.7616 21.9989 14.825C21.9989 15.5984 21.5364 15.995 20.6332 15.9963C17.4205 15.9988 14.2093 15.9963 10.9965 15.9963L10.998 15.9975ZM10.9602 15.714C14.2122 15.714 17.4642 15.714 20.7176 15.714C21.3299 15.714 21.6819 15.4231 21.6819 14.9158C21.6819 11.3733 21.6731 7.83214 21.6906 4.28971C21.6935 3.75132 21.3735 3.35841 20.5867 3.36463C17.5747 3.38576 14.5627 3.3696 11.5507 3.37706C11.1289 3.37706 10.7798 3.28007 10.4526 3.04632C9.25275 2.19335 8.03543 1.35779 6.83412 0.507305C6.60287 0.34442 6.3629 0.272303 6.06766 0.273547C4.50711 0.279764 2.94511 0.27479 1.38457 0.276034C0.625382 0.276034 0.308328 0.548337 0.308328 1.19615C0.308328 5.73081 0.308328 10.2642 0.308328 14.7989C0.308328 15.4479 0.622473 15.714 1.38602 15.714C4.57838 15.714 7.77074 15.714 10.9631 15.714H10.9602ZM21.6833 3.39944C21.6833 3.106 21.6833 2.87597 21.6833 2.64594C21.6833 2.0429 21.3633 1.76065 20.6638 1.76065C16.9231 1.7594 13.1825 1.76065 9.44182 1.76065C9.37055 1.76065 9.28183 1.72707 9.21348 1.82157C9.69924 2.16102 10.1937 2.49301 10.6679 2.84364C10.9107 3.02269 11.1667 3.09357 11.4852 3.09232C14.4754 3.08486 17.4656 3.09108 20.4558 3.08486C20.8834 3.08486 21.2921 3.10849 21.6819 3.3982L21.6833 3.39944Z" fill="black"/>
          </svg>
          <span>${folderName}</span>
        `;
        
        // Add click event for expand/collapse
        folderHeader.addEventListener('click', function() {
          folderWrapper.classList.toggle('collapsed');
          
          // Toggle icon visibility
          const openIcon = folderHeader.querySelector('.folder-icon-open');
          const closedIcon = folderHeader.querySelector('.folder-icon-closed');
          
          if (folderWrapper.classList.contains('collapsed')) {
            openIcon.style.display = 'none';
            closedIcon.style.display = 'block';
          } else {
            openIcon.style.display = 'block';
            closedIcon.style.display = 'none';
          }
          
          // Save collapse state to localStorage
          const folderStates = JSON.parse(localStorage.getItem('folderStates') || '{}');
          folderStates[folderName] = folderWrapper.classList.contains('collapsed');
          localStorage.setItem('folderStates', JSON.stringify(folderStates));
        });
        
        // Create files container (initially visible)
        const filesContainer = document.createElement('div');
        filesContainer.className = 'folder-files';
        filesContainer.style.marginLeft = '7px';
        filesContainer.style.marginTop = '10px';
        filesContainer.style.display = 'block';
        
        // Add drop zone functionality to folder
        folderWrapper.addEventListener('dragover', function(e) {
          e.preventDefault();
          folderWrapper.classList.add('drag-over');
        });
        
        folderWrapper.addEventListener('dragleave', function(e) {
          // Only remove highlight if leaving the entire folder wrapper
          if (!folderWrapper.contains(e.relatedTarget)) {
            folderWrapper.classList.remove('drag-over');
          }
        });
        
        folderWrapper.addEventListener('drop', function(e) {
          e.preventDefault();
          folderWrapper.classList.remove('drag-over');
          
          const fileName = e.dataTransfer.getData('text/plain');
          const sourceType = e.dataTransfer.getData('source-type');
          const sourceFolder = e.dataTransfer.getData('source-folder');
          
          console.log('Drop event triggered!');
          console.log('File name:', fileName);
          console.log('Source type:', sourceType);
          console.log('Source folder:', sourceFolder);
          console.log('Target folder:', folderName);
          
          if (fileName) {
            if (sourceType === 'standalone') {
              console.log('Moving standalone file to folder...');
              moveStandaloneFileToFolder(fileName, folderName);
            } else if (sourceType === 'folder' && sourceFolder && sourceFolder !== folderName) {
              console.log('Moving file between folders...');
              moveFileBetweenFolders(fileName, sourceFolder, folderName);s
            }
          } else {
            console.log('Drop conditions not met:');
            console.log('- Has fileName:', !!fileName);
            console.log('- Has sourceFolder:', !!sourceFolder);
            console.log('- Different folders:', sourceFolder !== folderName);
          }
        });
        
        folderWrapper.appendChild(folderHeader);
        folderWrapper.appendChild(filesContainer);
        
        if (insertBefore) {
          container.insertBefore(folderWrapper, insertBefore);
        } else {
          container.appendChild(folderWrapper);
        }
        
        // Restore folder collapse state from localStorage
        const folderStates = JSON.parse(localStorage.getItem('folderStates') || '{}');
        if (folderStates[folderName]) {
          folderWrapper.classList.add('collapsed');
          
          // Update icon visibility for collapsed state
          const openIcon = folderHeader.querySelector('.folder-icon-open');
          const closedIcon = folderHeader.querySelector('.folder-icon-closed');
          if (openIcon && closedIcon) {
            openIcon.style.display = 'none';
            closedIcon.style.display = 'block';
          }
        }
        
        // Load existing files for this folder
        loadFilesForFolder(folderName, filesContainer);
      }
      
      // Add file to specific folder
      function addFileToFolder(fileName, folderName) {
        const folderWrapper = document.querySelector(`[data-folder-name="${folderName}"]`);
        if (folderWrapper) {
          const filesContainer = folderWrapper.querySelector('.folder-files');
          createFileElement(fileName, filesContainer, folderName);
          
          // Save file-folder association to localStorage
          const folderFiles = JSON.parse(localStorage.getItem('folderFiles') || '{}');
          if (!folderFiles[folderName]) {
            folderFiles[folderName] = [];
          }
          if (!folderFiles[folderName].includes(fileName)) {
            folderFiles[folderName].push(fileName);
            localStorage.setItem('folderFiles', JSON.stringify(folderFiles));
          }
        }
      }

      // Add standalone file (without folder)
      function addStandaloneFile(fileName) {
        console.log('Adding standalone file:', fileName);
        const rightContainer = document.querySelector('.right');
        const uploadedFilesContainer = document.getElementById('uploadedFilesContainer');
        
        console.log('Right container:', rightContainer);
        console.log('Uploaded files container:', uploadedFilesContainer);
        
        if (rightContainer && uploadedFilesContainer) {
          // Check if file already exists to avoid duplicates
          const existingFile = rightContainer.querySelector(`[data-file-name="${fileName}"].standalone-file`);
          if (existingFile) {
            console.log('Standalone file already exists:', fileName);
            return;
          }
          
          // Create standalone file element
          const standaloneFileDiv = document.createElement('div');
          standaloneFileDiv.className = 'uploaded-file standalone-file';
          standaloneFileDiv.style.marginBottom = '10px';
          standaloneFileDiv.draggable = true;
          standaloneFileDiv.dataset.fileName = fileName;
          standaloneFileDiv.setAttribute('data-file-name', fileName);
          standaloneFileDiv.innerHTML = `<span>${fileName}</span>`;
          
          // Add drag event listeners for standalone files
          standaloneFileDiv.addEventListener('dragstart', function(e) {
            console.log('Drag start for standalone file:', fileName);
            e.dataTransfer.setData('text/plain', fileName);
            e.dataTransfer.setData('source-type', 'standalone');
            standaloneFileDiv.classList.add('dragging');
            
            // Create invisible drag image to prevent text duplication
            const canvas = document.createElement('canvas');
            canvas.width = 1;
            canvas.height = 1;
            const ctx = canvas.getContext('2d');
            ctx.globalAlpha = 0.01;
            e.dataTransfer.setDragImage(canvas, 0, 0);
          });
          
          standaloneFileDiv.addEventListener('dragend', function(e) {
            standaloneFileDiv.classList.remove('dragging');
          });
          
          // Insert after folders-wrapper
          const foldersWrapper = document.getElementById('folders-wrapper');
          if (foldersWrapper) {
            // Insert after the folders-wrapper
            if (foldersWrapper.nextSibling) {
              rightContainer.insertBefore(standaloneFileDiv, foldersWrapper.nextSibling);
            } else {
              rightContainer.appendChild(standaloneFileDiv);
            }
          } else {
            rightContainer.insertBefore(standaloneFileDiv, uploadedFilesContainer);
          }
          console.log('Standalone file element added to DOM');
          
          // Save to localStorage
          const standaloneFiles = JSON.parse(localStorage.getItem('standaloneFiles') || '[]');
          if (!standaloneFiles.includes(fileName)) {
            standaloneFiles.push(fileName);
            localStorage.setItem('standaloneFiles', JSON.stringify(standaloneFiles));
            console.log('Standalone file saved to localStorage');
          }
        } else {
          console.error('Could not find required containers for standalone file');
        }
      }

      // Load standalone file from localStorage (without saving again)
      function loadStandaloneFile(fileName) {
        console.log('Loading standalone file from storage:', fileName);
        const rightContainer = document.querySelector('.right');
        const uploadedFilesContainer = document.getElementById('uploadedFilesContainer');
        
        if (rightContainer && uploadedFilesContainer) {
          // Check if file already exists to avoid duplicates
          const existingFile = rightContainer.querySelector(`[data-file-name="${fileName}"].standalone-file`);
          if (existingFile) {
            console.log('Standalone file already loaded:', fileName);
            return;
          }
          
          // Create standalone file element
          const standaloneFileDiv = document.createElement('div');
          standaloneFileDiv.className = 'uploaded-file standalone-file';
          standaloneFileDiv.style.marginBottom = '10px';
          standaloneFileDiv.draggable = true;
          standaloneFileDiv.dataset.fileName = fileName;
          standaloneFileDiv.setAttribute('data-file-name', fileName);
          standaloneFileDiv.innerHTML = `<span>${fileName}</span>`;
          
          // Add drag event listeners for standalone files
          standaloneFileDiv.addEventListener('dragstart', function(e) {
            console.log('Drag start for loaded standalone file:', fileName);
            e.dataTransfer.setData('text/plain', fileName);
            e.dataTransfer.setData('source-type', 'standalone');
            standaloneFileDiv.classList.add('dragging');
          });
          
          standaloneFileDiv.addEventListener('dragend', function(e) {
            standaloneFileDiv.classList.remove('dragging');
          });
          
          // Insert after folders-wrapper
          const foldersWrapper = document.getElementById('folders-wrapper');
          if (foldersWrapper) {
            // Insert after the folders-wrapper
            if (foldersWrapper.nextSibling) {
              rightContainer.insertBefore(standaloneFileDiv, foldersWrapper.nextSibling);
            } else {
              rightContainer.appendChild(standaloneFileDiv);
            }
          } else {
            rightContainer.insertBefore(standaloneFileDiv, uploadedFilesContainer);
          }
          console.log('Standalone file loaded into DOM');
        }
      }

      // Create file element with drag functionality
      function createFileElement(fileName, container, folderName = null) {
        const fileDiv = document.createElement('div');
        fileDiv.className = 'uploaded-file';
        fileDiv.style.marginBottom = '10px';
        fileDiv.draggable = true;
        fileDiv.dataset.fileName = fileName;
        fileDiv.setAttribute('data-file-name', fileName);
        fileDiv.innerHTML = `<span>${fileName}</span>`;
        
        // Add drag event listeners
        fileDiv.addEventListener('dragstart', function(e) {
          console.log('Drag start for file:', fileName, 'from folder:', folderName);
          e.dataTransfer.setData('text/plain', fileName);
          e.dataTransfer.setData('source-type', 'folder');
          e.dataTransfer.setData('source-folder', folderName || '');
          fileDiv.classList.add('dragging');
        });
        
        fileDiv.addEventListener('dragend', function(e) {
          fileDiv.classList.remove('dragging');
        });
        
        container.appendChild(fileDiv);
      }
      
      // Load files for a specific folder
      function loadFilesForFolder(folderName, container) {
        const folderFiles = JSON.parse(localStorage.getItem('folderFiles') || '{}');
        if (folderFiles[folderName]) {
          folderFiles[folderName].forEach(fileName => {
            createFileElement(fileName, container, folderName);
          });
        }
      }
      
      // Move standalone file to folder
      function moveStandaloneFileToFolder(fileName, targetFolder) {
        console.log(`Moving standalone file "${fileName}" to folder "${targetFolder}"`);
        
        // Remove from standalone files
        const standaloneFiles = JSON.parse(localStorage.getItem('standaloneFiles') || '[]');
        const updatedStandaloneFiles = standaloneFiles.filter(file => file !== fileName);
        localStorage.setItem('standaloneFiles', JSON.stringify(updatedStandaloneFiles));
        
        // Add to target folder
        const folderFiles = JSON.parse(localStorage.getItem('folderFiles') || '{}');
        if (!folderFiles[targetFolder]) {
          folderFiles[targetFolder] = [];
        }
        if (!folderFiles[targetFolder].includes(fileName)) {
          folderFiles[targetFolder].push(fileName);
        }
        localStorage.setItem('folderFiles', JSON.stringify(folderFiles));
        
        // Update UI - remove standalone file element
        const standaloneFileElement = document.querySelector(`.standalone-file[data-file-name="${fileName}"]`);
        if (standaloneFileElement) {
          standaloneFileElement.remove();
        }
        
        // Add file to target folder display
        const targetFolderWrapper = document.querySelector(`[data-folder-name="${targetFolder}"]`);
        if (targetFolderWrapper) {
          const targetFilesContainer = targetFolderWrapper.querySelector('.folder-files');
          createFileElement(fileName, targetFilesContainer, targetFolder);
        }
        
        console.log(`✅ Successfully moved standalone file "${fileName}" to "${targetFolder}"`);
      }
      
      // Move file from folder to standalone
      function moveFileToStandalone(fileName, sourceFolder) {
        console.log(`Moving file "${fileName}" from folder "${sourceFolder}" to standalone`);
        
        // Remove from source folder
        const folderFiles = JSON.parse(localStorage.getItem('folderFiles') || '{}');
        if (folderFiles[sourceFolder]) {
          folderFiles[sourceFolder] = folderFiles[sourceFolder].filter(file => file !== fileName);
        }
        localStorage.setItem('folderFiles', JSON.stringify(folderFiles));
        
        // Add to standalone files
        const standaloneFiles = JSON.parse(localStorage.getItem('standaloneFiles') || '[]');
        if (!standaloneFiles.includes(fileName)) {
          standaloneFiles.push(fileName);
        }
        localStorage.setItem('standaloneFiles', JSON.stringify(standaloneFiles));
        
        // Update UI - remove from folder
        const sourceFileElement = document.querySelector(`[data-folder-name="${sourceFolder}"] .uploaded-file[data-file-name="${fileName}"]`);
        if (sourceFileElement) {
          sourceFileElement.remove();
        }
        
        // Add as standalone file
        addStandaloneFile(fileName);
        
        console.log(`✅ Successfully moved "${fileName}" from "${sourceFolder}" to standalone`);
      }

      // Move file between folders
      function moveFileBetweenFolders(fileName, sourceFolder, targetFolder) {
        console.log(`Moving "${fileName}" from "${sourceFolder}" to "${targetFolder}"`);
        
        const folderFiles = JSON.parse(localStorage.getItem('folderFiles') || '{}');
        console.log('Current folder files:', folderFiles);
        
        // Remove file from source folder
        if (folderFiles[sourceFolder]) {
          folderFiles[sourceFolder] = folderFiles[sourceFolder].filter(file => file !== fileName);
          console.log(`Removed from ${sourceFolder}:`, folderFiles[sourceFolder]);
        }
        
        // Add file to target folder
        if (!folderFiles[targetFolder]) {
          folderFiles[targetFolder] = [];
        }
        if (!folderFiles[targetFolder].includes(fileName)) {
          folderFiles[targetFolder].push(fileName);
          console.log(`Added to ${targetFolder}:`, folderFiles[targetFolder]);
        }
        
        // Save updated structure
        localStorage.setItem('folderFiles', JSON.stringify(folderFiles));
        console.log('Updated folder files saved:', folderFiles);
        
        // Update UI - remove file from source folder display
        const sourceFileElement = document.querySelector(`[data-folder-name="${sourceFolder}"] .uploaded-file[data-file-name="${fileName}"]`);
        console.log('Source file element found:', sourceFileElement);
        if (sourceFileElement) {
          sourceFileElement.remove();
          console.log(`Removed file element from ${sourceFolder}`);
        }
        
        // Add file to target folder display
        const targetFolderWrapper = document.querySelector(`[data-folder-name="${targetFolder}"]`);
        console.log('Target folder wrapper found:', targetFolderWrapper);
        if (targetFolderWrapper) {
          const targetFilesContainer = targetFolderWrapper.querySelector('.folder-files');
          console.log('Target files container found:', targetFilesContainer);
          createFileElement(fileName, targetFilesContainer, targetFolder);
          console.log(`Added file element to ${targetFolder}`);
        }
        
        // Show success message
        console.log(`✅ Successfully moved "${fileName}" from "${sourceFolder}" to "${targetFolder}"`);
      }
      
      // Save folder to localStorage
      function saveFolder(folderName) {
        const savedFolders = JSON.parse(localStorage.getItem('userFolders') || '[]');
        if (!savedFolders.includes(folderName)) {
          savedFolders.push(folderName);
          localStorage.setItem('userFolders', JSON.stringify(savedFolders));
        }
      }
      
      // Create New Folder functionality
      const createNewFolderLink = document.getElementById('createFolderLink');
      const rightContainer = document.querySelector('.right');
      
      console.log('Create folder link:', createNewFolderLink);
      console.log('Right container:', rightContainer);
      
      if (createNewFolderLink) {
        createNewFolderLink.addEventListener('click', function(e) {
          e.preventDefault();
          console.log('Create folder clicked!');
          alert('Create folder clicked! Check console for more details.');
          
          if (isCreatingFolder) {
            console.log('Already creating folder, returning...');
            return; // Prevent multiple folder creation forms
          }
        
          isCreatingFolder = true;
          console.log('Creating folder form...');
          
          // Create folder creation form - Step by step
          const folderForm = document.createElement('div');
          folderForm.className = 'folder-creation-form';
          
          // Create the content step by step
          const iconDiv = document.createElement('div');
          iconDiv.style.display = 'flex';
          iconDiv.style.alignItems = 'center';
          iconDiv.style.gap = '10px';
          iconDiv.style.marginBottom = '15px';
          
          // Add folder icon
          iconDiv.innerHTML = '<svg width="20" height="14" viewBox="0 0 25 17" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11.0216 17C7.83067 17 4.63971 16.9995 1.44925 17C0.636891 17 0.0414929 16.4172 0.0034994 15.5775C0.000999829 15.5176 0.00149974 15.4571 0.00149974 15.3967C0.00199966 10.7986 0.00299949 6.20049 0 1.60239C0 1.08311 0.137477 0.636162 0.540908 0.301342C0.798864 0.0874285 1.09331 0.00217325 1.42326 0.00268995C3.95583 0.00630683 6.48889 0.00475674 9.02146 0.00424004C9.3629 0.00424004 9.70485 0.00372334 10.0463 0.000106454C10.9166 -0.00919412 11.514 0.591726 11.5225 1.48975C11.5255 1.79098 11.538 2.09325 11.5185 2.39345C11.502 2.65077 11.602 2.71122 11.8355 2.71019C14.1351 2.70296 16.4342 2.70554 18.7338 2.70554C19.3422 2.70554 19.9501 2.70296 20.5585 2.70657C21.4358 2.71174 22.0162 3.29096 22.0537 4.19518C22.0597 4.34141 22.0662 4.48867 22.0537 4.63386C22.0337 4.86585 22.1337 4.93251 22.3467 4.92579C22.7461 4.91287 23.1466 4.92114 23.5465 4.92217C24.6078 4.92579 25.2442 5.83156 24.9113 6.87581C24.2834 8.84598 23.6495 10.8141 23.0181 12.7827C22.6881 13.812 22.3567 14.8412 22.0282 15.871C21.9218 16.2053 21.7643 16.5035 21.4853 16.7179C21.2139 16.9271 20.9069 16.9974 20.57 16.9969C17.3875 16.9923 14.2051 16.9938 11.0221 16.9938V16.999L11.0216 17ZM11.1981 15.9821C14.2966 15.9821 17.395 15.9821 20.494 15.9821C20.8904 15.9821 20.9544 15.9444 21.0774 15.5636C22.0397 12.5755 22.9991 9.58641 23.9554 6.59679C24.1014 6.14107 23.9344 5.93594 23.435 5.93594C17.388 5.93594 11.3406 5.93594 5.2936 5.93594C4.84517 5.93594 4.76519 5.99639 4.62621 6.43042C3.82985 8.91315 3.03298 11.3959 2.23662 13.8791C2.03765 14.4997 1.84119 15.1218 1.63672 15.7403C1.57773 15.918 1.60823 16.0033 1.80319 15.9837C1.85268 15.9785 1.90318 15.9831 1.95317 15.9831C5.03514 15.9831 8.11712 15.9831 11.1991 15.9831L11.1981 15.9821ZM1.01133 14.3183C1.10981 14.2238 1.11481 14.1246 1.14281 14.0383C1.99916 11.3768 2.84901 8.71267 3.71037 6.05271C3.97982 5.22134 4.41125 4.92269 5.2616 4.92269C10.3422 4.92269 15.4234 4.92373 20.504 4.92166C21.1214 4.92166 21.0464 5.0095 21.0499 4.36156C21.0529 3.83556 20.9629 3.74514 20.455 3.74514C17.5815 3.74514 14.708 3.74514 11.8345 3.7441C11.685 3.7441 11.534 3.73945 11.3861 3.71982C10.8671 3.65058 10.5472 3.27804 10.5432 2.74377C10.5402 2.33042 10.5477 1.91706 10.5392 1.50422C10.5327 1.1849 10.3762 1.02059 10.0778 1.02007C7.20427 1.018 4.33076 1.018 1.45725 1.02007C1.1508 1.02007 1.00183 1.17663 0.986332 1.49646C0.977833 1.67679 0.981833 1.85764 0.981833 2.03796C0.981833 5.96332 0.981333 9.8892 0.982832 13.8146C0.982832 13.9737 1.00033 14.1328 1.01183 14.3183H1.01133Z" fill="black" fill-opacity="0.5"></path></svg>';
          
          // Create input field
          const inputField = document.createElement('input');
          inputField.type = 'text';
          inputField.id = 'folderNameInput';
          inputField.placeholder = 'Enter folder name...';
          inputField.style.flex = '1';
          inputField.style.padding = '10px';
          inputField.style.border = 'none';
          inputField.style.borderRadius = '5px';
          inputField.style.fontFamily = "'Poppins', sans-serif";
          inputField.style.fontSize = '13px';
          inputField.style.outline = 'none';
          
          iconDiv.appendChild(inputField);
          
          // Create buttons div
          const buttonsDiv = document.createElement('div');
          buttonsDiv.style.display = 'flex';
          buttonsDiv.style.gap = '10px';
          buttonsDiv.style.justifyContent = 'flex-end';
          
          // Save button
          const saveBtn = document.createElement('button');
          saveBtn.id = 'saveFolderBtn';
          saveBtn.textContent = 'Save';
          saveBtn.style.padding = '0';
          saveBtn.style.backgroundColor = 'transparent';
          saveBtn.style.color = '#303030eb';
          saveBtn.style.border = 'none';
          saveBtn.style.borderRadius = '0';
          saveBtn.style.cursor = 'pointer';
          saveBtn.style.fontFamily = "'Poppins', sans-serif";
          saveBtn.style.fontWeight = '500';
          saveBtn.style.fontSize = '13px';
          saveBtn.style.textDecoration = 'underline';
          saveBtn.style.background = 'none';
          
          // Cancel button
          const cancelBtn = document.createElement('button');
          cancelBtn.id = 'cancelFolderBtn';
          cancelBtn.textContent = 'Cancel';
          cancelBtn.style.padding = '0';
          cancelBtn.style.backgroundColor = 'transparent';
          cancelBtn.style.color = '#303030eb';
          cancelBtn.style.border = 'none';
          cancelBtn.style.borderRadius = '0';
          cancelBtn.style.cursor = 'pointer';
          cancelBtn.style.fontFamily = "'Poppins', sans-serif";
          cancelBtn.style.fontWeight = '500';
          cancelBtn.style.fontSize = '13px';
          cancelBtn.style.textDecoration = 'underline';
          cancelBtn.style.background = 'none';
          
          buttonsDiv.appendChild(saveBtn);
          buttonsDiv.appendChild(cancelBtn);
          
          folderForm.appendChild(iconDiv);
          folderForm.appendChild(buttonsDiv);
          
          // Insert the form before the uploaded files container
          let uploadedFilesContainer = document.getElementById('uploadedFilesContainer');
          
          // Create uploadedFilesContainer if it doesn't exist
          if (!uploadedFilesContainer) {
            uploadedFilesContainer = document.createElement('div');
            uploadedFilesContainer.id = 'uploadedFilesContainer';
            uploadedFilesContainer.style.display = 'none';
            rightContainer.appendChild(uploadedFilesContainer);
          }
          
          console.log('Uploaded files container:', uploadedFilesContainer);
          console.log('Right container:', rightContainer);
          
          if (rightContainer) {
            rightContainer.insertBefore(folderForm, uploadedFilesContainer);
            console.log('Form inserted successfully');
            
            // Auto-scroll to bottom if there's scrollable content
            const foldersWrapper = document.getElementById('folders-wrapper');
            if (foldersWrapper) {
              setTimeout(() => {
                foldersWrapper.scrollTo({
                  top: foldersWrapper.scrollHeight,
                  behavior: 'smooth'
                });
              }, 100);
            }
            
            // Focus on input field
            inputField.focus();
            
            // Save button functionality
            saveBtn.addEventListener('click', function() {
              const folderName = inputField.value.trim();
              if (folderName) {
                // Save to localStorage
                saveFolder(folderName);
                
                // Get or create folders wrapper
                let foldersWrapper = document.getElementById('folders-wrapper');
                if (!foldersWrapper) {
                  foldersWrapper = document.createElement('div');
                  foldersWrapper.id = 'folders-wrapper';
                  foldersWrapper.className = 'folders-container';
                  rightContainer.insertBefore(foldersWrapper, uploadedFilesContainer);
                }
                
                // Create the folder element
                createFolderElement(folderName, foldersWrapper, null);
                
                // Remove the form
                folderForm.remove();
                isCreatingFolder = false;
              } else {
                alert('Please enter a folder name');
              }
            });
            
            // Cancel button functionality
            cancelBtn.addEventListener('click', function() {
              folderForm.remove();
              isCreatingFolder = false;
            });
            
            // Enter key to save
            inputField.addEventListener('keypress', function(e) {
              if (e.key === 'Enter') {
                saveBtn.click();
              }
            });
          } else {
            console.error('Could not find containers to insert form');
            isCreatingFolder = false;
          }
        });
      } else {
        console.error('Create folder link not found!');
      }
      
      // Load saved folders when page loads
      loadSavedFolders();
      
      // Add drop zone functionality to main area (to make files standalone)
      function initializeMainDropZone() {
        const rightContainer = document.querySelector('.right');
        
        if (rightContainer) {
          rightContainer.addEventListener('dragover', function(e) {
            // Only accept drops outside of folder areas
            const targetFolder = e.target.closest('.folder-wrapper');
            if (!targetFolder) {
              e.preventDefault();
              rightContainer.style.backgroundColor = '#f0f8ff';
            }
          });
          
          rightContainer.addEventListener('dragleave', function(e) {
            // Only clear style if we're leaving the main container
            if (!rightContainer.contains(e.relatedTarget)) {
              rightContainer.style.backgroundColor = '';
            }
          });
          
          rightContainer.addEventListener('drop', function(e) {
            // Only accept drops outside of folder areas
            const targetFolder = e.target.closest('.folder-wrapper');
            if (!targetFolder) {
              e.preventDefault();
              rightContainer.style.backgroundColor = '';
              
              const fileName = e.dataTransfer.getData('text/plain');
              const sourceType = e.dataTransfer.getData('source-type');
              const sourceFolder = e.dataTransfer.getData('source-folder');
              
              console.log('Drop on main area:');
              console.log('File name:', fileName);
              console.log('Source type:', sourceType);
              console.log('Source folder:', sourceFolder);
              
              if (fileName && sourceType === 'folder' && sourceFolder) {
                console.log('Moving file from folder to standalone...');
                moveFileToStandalone(fileName, sourceFolder);
              }
            }
          });
        }
      }
      
      // Initialize main drop zone
      initializeMainDropZone();
      
      // Initialize default setup - add existing file to Anatomy folder
      function initializeDefaultSetup() {
        const savedFolders = JSON.parse(localStorage.getItem('userFolders') || '[]');
        const folderFiles = JSON.parse(localStorage.getItem('folderFiles') || '{}');
        
        // If no folders exist, create default folder
        if (savedFolders.length === 0) {
          // Create empty default setup
          localStorage.setItem('folderFiles', JSON.stringify({}));
        }
      }
      
      // Initialize on page load
      initializeDefaultSetup();
      
      // Force refresh all folders and files to ensure proper data attributes
      function refreshAllFoldersAndFiles() {
        console.log('Refreshing all folders and files...');
        
        // Clear existing folder display
        const existingFoldersWrapper = document.getElementById('folders-wrapper');
        if (existingFoldersWrapper) {
          existingFoldersWrapper.remove();
        }
        
        // Reload all folders and files
        const savedFolders = JSON.parse(localStorage.getItem('userFolders') || '[]');
        const rightContainer = document.querySelector('.right');
        
        // Create uploadedFilesContainer if it doesn't exist
        let uploadedFilesContainer = document.getElementById('uploadedFilesContainer');
        if (!uploadedFilesContainer) {
          uploadedFilesContainer = document.createElement('div');
          uploadedFilesContainer.id = 'uploadedFilesContainer';
          uploadedFilesContainer.style.display = 'none';
          rightContainer.appendChild(uploadedFilesContainer);
        }
        
        // Create new folders wrapper
        const foldersWrapper = document.createElement('div');
        foldersWrapper.id = 'folders-wrapper';
        foldersWrapper.className = 'folders-container';
        rightContainer.insertBefore(foldersWrapper, uploadedFilesContainer);
        
        savedFolders.forEach(folderName => {
          createFolderElement(folderName, foldersWrapper, null);
        });
        
        console.log('All folders and files refreshed');
      }
      
      // Call refresh after a short delay to ensure DOM is ready
      setTimeout(refreshAllFoldersAndFiles, 100);
      

      
    </script>
  </body>
</html>
